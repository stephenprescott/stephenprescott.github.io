{% macro caseStudyHeader(eyebrow="", title="", summary="", meta=[], image="", imageAlt="") -%}
<header class="ws-root ws-case-head">{% if eyebrow %}<p class="ws-eyebrow">{{ eyebrow }}</p>{% endif %}<h1 class="ws-hero-title">{{ title }}</h1>{% if summary %}<p class="ws-hero-body">{{ summary }}</p>{% endif %}{% if meta | length %}<dl class="ws-meta">{% for m in meta %}<div><dt class="ws-eyebrow">{{ m.label }}</dt><dd>{{ m.value }}</dd></div>{% endfor %}</dl>{% endif %}{% if image %}<img class="ws-case-img" src="{{ image }}" alt="{{ imageAlt }}">{% endif %}</header>
{%- endmacro %}
