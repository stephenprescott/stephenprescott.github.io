{% macro avatar(src="", alt="", name="", size=120) -%}
{% if src -%}
<img class="ws-avatar" src="{{ src }}" alt="{{ alt }}" style="width: {{ size }}px; height: {{ size }}px;">
{%- else -%}
{% set parts = name.split(" ") | select -%}
{% set initials = (parts | first)[0] + ((parts | last)[0] if parts.length > 1 else "") -%}
<span class="ws-avatar ws-avatar-initials" role="img" aria-label="{{ name }}" style="font-size: {{ size * 0.38 }}px; width: {{ size }}px; height: {{ size }}px;">{{ initials | upper }}</span>
{%- endif %}
{%- endmacro %}
