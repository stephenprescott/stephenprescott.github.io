{% macro shellNav(site) -%}
<header class="sh-nav" data-sh-nav><a class="sh-brand" href="/">{{ site.name }}</a><div class="sh-nav-r"><nav aria-label="Main"><ul class="sh-links" id="sh-links">{% for l in site.nav %}<li><a href="{{ l.href }}">{{ l.label }}</a></li>{% endfor %}</ul></nav>{% if site.resume %}<a class="sh-res" href="{{ site.resume }}">Résumé</a>{% endif %}<button class="sh-menu-btn" type="button" aria-expanded="false" aria-controls="sh-links" aria-label="Open menu" hidden><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14"/></svg></button></div></header>
{%- endmacro %}
