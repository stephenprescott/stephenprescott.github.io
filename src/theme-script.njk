permalink: /assets/js/theme.js
eleventyExcludeFromCollections: true
---
(function () {
  var root = document.documentElement;
  var icons = { sun: {{ icons.sun | dump | safe }}, moon: {{ icons.moon | dump | safe }} };
  var btn = document.querySelector('.ws-icon-btn[aria-label^="Switch to"]');
  if (!btn) return;
  function paint() {
    var light = root.dataset.theme === 'light';
    btn.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
    btn.title = light ? 'Dark mode' : 'Light mode';
    var svg = btn.querySelector('svg');
    if (svg) svg.innerHTML = light ? icons.moon : icons.sun;
  }
  btn.addEventListener('click', function () {
    var next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('ws-theme', next); } catch (e) {}
    paint();
  });
  paint();
})();
